    <path d="M6 21a10 10 0 0 1 20 0" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
    <path d="M3 25.5h26" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
    <path d="M16 5.5v3.5M7.2 9.2l2.3 2.3M24.8 9.2l-2.3 2.3" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
  </svg>
  <span class="logo__name">STILLWAG</span>
</span>
