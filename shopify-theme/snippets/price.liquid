{%- comment -%}
  Usage: {% render 'price', product: product, variant: variant, show_badge: true, size: 'large' %}
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign price = target.price
  assign compare = target.compare_at_price
  assign on_sale = false
  if compare > price
    assign on_sale = true
    assign saving = compare | minus: price | times: 100 | divided_by: compare | round
  endif
-%}
<div class="price{% if size %} price--{{ size }}{% endif %}{% if on_sale %} price--sale{% endif %}">
  <span class="price__current">{{ price | money }}</span>
  {%- if on_sale -%}
    <s class="price__compare">{{ compare | money }}</s>
    {%- if show_badge -%}<span class="badge badge--sale">Save {{ saving }}%</span>{%- endif -%}
  {%- endif -%}
</div>
