<div class="search-drawer" id="SearchDrawer" hidden>
  <div class="search-drawer__overlay" data-search-close></div>
  <div class="search-drawer__panel" role="dialog" aria-modal="true" aria-label="Search">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-drawer__form page-width">
      {% render 'icon', name: 'search', size: 22 %}
      <input type="search" name="q" placeholder="Search products" aria-label="Search" autocomplete="off">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="button" class="icon-button" data-search-close aria-label="Close search">{% render 'icon', name: 'close', size: 22 %}</button>
    </form>
  </div>
</div>
