{%- if section.blocks.size > 0 -%}
<div class="announcement" style="--ann-bg: {{ section.settings.bg }}; --ann-fg: {{ section.settings.fg }};" data-announcement>
  <div class="announcement__inner page-width">
    {%- for block in section.blocks -%}
      <p class="announcement__msg{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
        {{ block.settings.text }}
        {%- if block.settings.link != blank -%}</a>{%- endif -%}
      </p>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 5,
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#151515" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free US shipping on every order" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Announcement bar", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
