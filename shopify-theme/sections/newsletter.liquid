<section class="section newsletter">
  <div class="page-width">
    <div class="newsletter__card" style="--nl-bg: {{ section.settings.bg }}; --nl-fg: {{ section.settings.fg }};">
      <div class="newsletter__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
      </div>
      {%- form 'customer', id: 'NewsletterSection', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, waitlist">
        {%- if form.posted_successfully? -%}
          <p class="newsletter__success">{% render 'icon', name: 'check', size: 18, stroke: 2 %} You're in. Watch your inbox.</p>
        {%- else -%}
          <div class="field-pill">
            <label class="visually-hidden" for="NewsletterEmail">Email</label>
            <input id="NewsletterEmail" type="email" name="contact[email]" placeholder="Enter your email" autocomplete="email" required>
            <button type="submit" class="button">{{ section.settings.button_label }}</button>
          </div>
          <p class="newsletter__fine">No spam. Unsubscribe anytime.</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Email signup",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text", "default": "Launching soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 15% off launch day" },
    { "type": "text", "id": "text", "label": "Text", "default": "Join the waitlist and we'll send your code the moment we open." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the waitlist" },
    { "type": "color", "id": "bg", "label": "Card background", "default": "#24563A" },
    { "type": "color", "id": "fg", "label": "Card text", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Email signup" }]
}
{% endschema %}
