<section class="section faq section--{{ section.settings.background }}">
  <div class="page-width faq__inner">
    <div class="faq__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte section-sub">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="accordion" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary><span>{{ block.settings.question }}</span><span class="accordion__icon">{% render 'icon', name: 'plus', size: 18 %}</span></summary>
          <div class="accordion__body rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Can't find what you're looking for? <a href=\"/pages/contact\">Contact us</a> and we'll get back to you within a day.</p>" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": true },
    { "type": "select", "id": "background", "label": "Background", "options": [{ "value": "plain", "label": "Plain" }, { "value": "soft", "label": "Soft" }], "default": "plain" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "When will my order ship?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Orders are processed within 1–2 business days and tracking is emailed as soon as your order leaves us.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
