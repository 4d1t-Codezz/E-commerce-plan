{%- liquid
  assign collection = section.settings.collection
  if collection == blank
    assign collection = collections['all']
  endif
-%}
<section class="section featured section--{{ section.settings.background }}">
  <div class="page-width">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ collection.url | default: routes.all_products_collection_url }}" class="link-arrow">{{ section.settings.link_label }} {% render 'icon', name: 'arrow-right', size: 16 %}</a>
      {%- endif -%}
    </div>
    <div class="grid grid--{{ section.settings.columns }}">
      {%- for product in collection.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="card card--empty"><div class="card__media"><div class="card__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div></div><div class="card__info"><h3 class="card__title">Your product</h3><div class="price"><span class="price__current">$34.99</span></div></div></article>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text", "default": "The lineup" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three gummies. One simple routine." },
    { "type": "collection", "id": "collection", "label": "Collection (defaults to all products)" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 3 },
    { "type": "select", "id": "columns", "label": "Columns", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "3" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" },
    { "type": "select", "id": "background", "label": "Background", "options": [{ "value": "plain", "label": "Plain" }, { "value": "soft", "label": "Soft" }], "default": "plain" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
