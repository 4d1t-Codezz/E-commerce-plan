<section class="section steps section--{{ section.settings.background }}">
  <div class="page-width">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
    </div>
    <ol class="steps__list">
      {%- for block in section.blocks -%}
        <li class="step" {{ block.shopify_attributes }}>
          <span class="step__num">{{ forloop.index | prepend: '0' }}</span>
          <h3 class="step__title">{{ block.settings.title }}</h3>
          <p class="step__text">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Steps",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two gummies. That's the whole routine." },
    { "type": "select", "id": "background", "label": "Background", "options": [{ "value": "plain", "label": "Plain" }, { "value": "soft", "label": "Soft" }], "default": "plain" }
  ],
  "blocks": [
    {
      "type": "step", "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Chew two a day" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Keep the bag somewhere you'll see it." }
      ]
    }
  ],
  "presets": [{ "name": "Steps", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
