<section class="collection page-width">
  <header class="collection__head"><h1 class="h1">{{ blog.title }}</h1></header>
  <div class="grid grid--3">
    {%- for article in blog.articles -%}
      <a href="{{ article.url }}" class="article-card">
        {%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
        <span class="eyebrow">{{ article.published_at | date: '%B %d, %Y' }}</span>
        <h2 class="h3">{{ article.title }}</h2>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}{ "name": "Blog" }{% endschema %}
