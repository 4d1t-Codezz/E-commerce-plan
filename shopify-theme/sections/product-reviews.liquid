{%- assign rv_rating = product.metafields.reviews.rating.value.rating -%}
{%- assign rv_count = product.metafields.reviews.rating_count.value -%}
<section class="section sw-reviews" id="reviews">
  <div class="page-width">
    <div class="sw-reviews__head">
      <h2 class="h2">{{ section.settings.heading }}</h2>
      <div class="sw-reviews__score">
        {%- if rv_count > 0 -%}
          {% render 'stars', rating: rv_rating, size: 20 %}
          <span><strong>{{ rv_rating | round: 1 }}</strong> from {{ rv_count }} {{ rv_count | pluralize: 'review', 'reviews' }}</span>
        {%- else -%}
          {% render 'stars', rating: 0, size: 20 %}
          <span>No reviews yet</span>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="sw-reviews__app">
        {%- for block in section.blocks -%}{% render block %}{%- endfor -%}
      </div>
    {%- else -%}
      <div class="sw-reviews__app">
        <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}">{{ product.metafields.judgeme.widget }}</div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product reviews",
  "settings": [
    { "type": "paragraph", "content": "Shows real reviews only. Install a reviews app (for example Judge.me) and add its widget block here." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reviews" },
    { "type": "text", "id": "empty_title", "label": "Empty title", "default": "Be the first to review this" },
    { "type": "textarea", "id": "empty_text", "label": "Empty text", "default": "Bought a jar? Tell us how your dog gets on with it." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Write a review" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Product reviews" }]
}
{% endschema %}
