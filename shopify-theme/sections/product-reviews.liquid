{%- assign rv_rating = product.metafields.reviews.rating.value.rating -%}
{%- assign rv_count = product.metafields.reviews.rating_count.value -%}
<section class="section sw-reviews" id="reviews">
  <div class="page-width">
    <div class="sw-reviews__head">
      <h2 class="h2">{{ section.settings.heading }}</h2>
      <div class="sw-reviews__score">
        {%- if rv_count > 0 -%}
          {% render 'stars', rating: rv_rating, size: 20 %}
          <span><strong>{{ rv_rating | round: 1 }}</strong> from {{ rv_count }} {{ rv_count | pluralize: 'review', 'reviews' }}</span>
        {%- elsif section.settings.source_rating != blank -%}
          {% render 'stars', rating: section.settings.source_rating, size: 20 %}
          <span><strong>{{ section.settings.source_rating }}</strong> {{ section.settings.source_label }}</span>
        {%- else -%}
          {% render 'stars', rating: 0, size: 20 %}
          <span>No reviews yet</span>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="sw-reviews__list">
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            {% render block %}
          {%- else -%}
            <figure class="sw-review" {{ block.shopify_attributes }}>
              <span class="sw-review__mark" aria-hidden="true">&ldquo;</span>
              {% render 'stars', rating: block.settings.rating, size: 18 %}
              {%- if block.settings.title != blank -%}<p class="sw-review__title">{{ block.settings.title }}</p>{%- endif -%}
              <blockquote class="sw-review__body">{{ block.settings.quote }}</blockquote>
              <figcaption class="sw-review__meta"><span class="sw-review__avatar" aria-hidden="true">{{ block.settings.author | slice: 0 }}</span><span><strong>{{ block.settings.author }}</strong><span>{{ block.settings.source }}</span></span></figcaption>
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="sw-reviews__empty">
      <p class="sw-reviews__empty-title">{{ section.settings.empty_title }}</p>
      <p>{{ section.settings.empty_text }}</p>
      {%- if section.settings.button_label != blank -%}
        <a class="button button--secondary" href="{{ section.settings.button_link | default: '/pages/contact' }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product reviews",
  "settings": [
    { "type": "paragraph", "content": "Real reviews only. Reviews from other sites must say where they came from." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reviews" },
    { "type": "text", "id": "source_rating", "label": "Outside rating (e.g. 4.6)" },
    { "type": "text", "id": "source_label", "label": "Outside rating label", "default": "from 11K+ ratings on Amazon" },
    { "type": "text", "id": "empty_title", "label": "Box title", "default": "Bought a jar from us?" },
    { "type": "textarea", "id": "empty_text", "label": "Box text", "default": "Tell us how your dog gets on with it." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Write a review" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "quote", "name": "Review", "settings": [
      { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "quote", "label": "Review text" },
      { "type": "text", "id": "author", "label": "Name", "default": "Amazon customer" },
      { "type": "text", "id": "source", "label": "Source", "default": "Review from Amazon" }
    ] }
  ],
  "presets": [{ "name": "Product reviews" }]
}
{% endschema %}
