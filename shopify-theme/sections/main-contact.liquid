<section class="page page-width page-width--narrow">
  <p class="eyebrow">We're here to help</p>
  <h1 class="h1">{{ page.title | default: 'Contact' }}</h1>
  {%- if page.content != blank -%}<div class="rte">{{ page.content }}</div>{%- else -%}<p class="section-sub">Questions about an order or a product? Send us a message and we'll reply within 3 days.</p>{%- endif -%}
  {%- form 'contact', class: 'contact-form' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-success">{% render 'icon', name: 'check', size: 18, stroke: 2 %} Thanks! We'll be in touch shortly.</p>
    {%- endif -%}
    {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div class="contact-form__row">
      <label><span>Name</span><input type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></label>
      <label><span>Email *</span><input type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></label>
    </div>
    <label><span>Order number (optional)</span><input type="text" name="contact[order]"></label>
    <label><span>Message</span><textarea name="contact[body]" rows="6">{{ form.body }}</textarea></label>
    <button type="submit" class="button button--large">Send message</button>
  {%- endform -%}
</section>
{% schema %}{ "name": "Contact form" }{% endschema %}
