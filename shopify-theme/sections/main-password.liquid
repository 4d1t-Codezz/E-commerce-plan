<section class="password">
  <div class="password__media">
    <img src="{{ section.settings.asset_image | asset_url }}" alt="" width="1600" height="1600">
  </div>
  <div class="password__content">
    {% render 'wordmark', size: 'large' %}
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="password__heading">{{ section.settings.heading }}</h1>
    <p class="section-sub">{{ section.settings.text }}</p>
    {%- form 'customer', class: 'password__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect, password page, waitlist">
      {%- if form.posted_successfully? -%}
        <p class="newsletter__success">{% render 'icon', name: 'check', size: 18, stroke: 2 %} You're on the list. See you on launch day.</p>
      {%- else -%}
        <div class="field-pill field-pill--light">
          <label class="visually-hidden" for="PasswordEmail">Email</label>
          <input id="PasswordEmail" type="email" name="contact[email]" placeholder="Enter your email" autocomplete="email" required>
          <button type="submit" class="button">Notify me</button>
        </div>
      {%- endif -%}
    {%- endform -%}
    <details class="password__login">
      <summary>Store owner? Enter password</summary>
      {%- form 'storefront_password', class: 'password__login-form' -%}
        {%- if form.errors -%}<p class="form-error">Wrong password.</p>{%- endif -%}
        <div class="field-pill field-pill--light">
          <input type="password" name="password" placeholder="Password" autocomplete="current-password" aria-label="Password">
          <button type="submit" class="button button--outline">Enter</button>
        </div>
      {%- endform -%}
    </details>
    <p class="password__fine">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Opening soon page",
  "settings": [
    { "type": "text", "id": "asset_image", "label": "Bundled image file", "default": "hero.jpg" },
    { "type": "text", "id": "eyebrow", "label": "Small text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening Soon" },
    { "type": "text", "id": "text", "label": "Text", "default": "We're putting the finishing touches on the store. Leave your email and we'll let you know when we open, plus 15% off your first order." }
  ]
}
{% endschema %}
