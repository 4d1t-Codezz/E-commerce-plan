<section class="wave" style="--wave-bg: {{ section.settings.bg }}; --wave-fg: {{ section.settings.fg }};">
  <svg class="wave__edge wave__edge--top" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60 C 380 20 760 20 1100 46 S 1440 70 1440 44 V80 H0 Z" fill="currentColor"/></svg>
  <div class="wave__body">
    <div class="page-width wave__inner{% if section.settings.image_right %} wave__inner--reverse{% endif %}">
      <div class="wave__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'wave__img', alt: '' }}
        {%- elsif section.settings.asset_image != blank -%}
          <img src="{{ section.settings.asset_image | asset_url }}" alt="" loading="lazy" class="wave__img" width="1200" height="1200">
        {%- endif -%}
      </div>
      <div class="wave__content">
        <h2 class="h2">{{ section.settings.heading }}</h2>
        <div class="rte">{{ section.settings.text }}</div>
        {%- if section.blocks.size > 0 -%}
          <ul class="wave__list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}><span><strong>{{ block.settings.title }}</strong> {{ block.settings.text }}</span></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button button--large">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
  <svg class="wave__edge wave__edge--bottom" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0 H1440 V30 C 1080 80 720 70 360 40 S 0 30 0 40 Z" fill="currentColor"/></svg>
</section>

{% schema %}
{
  "name": "Wave banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "asset_image", "label": "Bundled image file (used when no image is picked)", "default": "story.jpg" },
    { "type": "checkbox", "id": "image_right", "label": "Image on the right", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made For Real Routines" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Daily gummies you'll actually remember to take.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#FFFFFF" }
  ],
  "blocks": [
    { "type": "point", "name": "Point", "settings": [
      { "type": "text", "id": "title", "label": "Bold text", "default": "Vegan." },
      { "type": "text", "id": "text", "label": "Text", "default": "No gelatin, no animal products." }
    ] }
  ],
  "presets": [{ "name": "Wave banner" }]
}
{% endschema %}
