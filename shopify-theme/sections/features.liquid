<section class="section features section--{{ section.settings.background }}">
  <div class="page-width">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="section-sub">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="features__grid">
      {%- for block in section.blocks -%}
        <div class="feature" {{ block.shopify_attributes }}>
          <span class="feature__icon">{% render 'icon', name: block.settings.icon, size: 26, stroke: 1.5 %}</span>
          <h3 class="feature__title">{{ block.settings.title }}</h3>
          <p class="feature__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Icon features",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text", "default": "Why shop with us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made to be taken every day" },
    { "type": "text", "id": "text", "label": "Text", "default": "Quality you can check, service you can reach, and a shopping experience you can trust." },
    { "type": "select", "id": "background", "label": "Background", "options": [{ "value": "plain", "label": "Plain" }, { "value": "soft", "label": "Soft" }], "default": "soft" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" }, { "value": "return", "label": "Return" },
            { "value": "lock", "label": "Lock" }, { "value": "leaf", "label": "Leaf" }, { "value": "flask", "label": "Flask" },
            { "value": "sparkle", "label": "Sparkle" }, { "value": "heart", "label": "Heart" }, { "value": "sun", "label": "Sun" },
            { "value": "moon", "label": "Moon" }, { "value": "drop", "label": "Drop" }, { "value": "clock", "label": "Clock" }, { "value": "gift", "label": "Gift" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Clean ingredients" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Vegan, gluten-free and free from artificial dyes." }
      ]
    }
  ],
  "presets": [{ "name": "Icon features", "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }, { "type": "feature" }] }]
}
{% endschema %}
