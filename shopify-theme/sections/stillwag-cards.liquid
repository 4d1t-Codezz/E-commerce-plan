<section class="section sw-cards sw-cards--{{ section.settings.style }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="sw-cards__head">
        <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <ul class="sw-cards__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="sw-card reveal" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}<span class="sw-card__icon">{% render 'icon', name: block.settings.icon, size: 34 %}</span>{%- endif -%}
          <p class="sw-card__title">{{ block.settings.title }}</p>
          {%- if block.settings.text != blank -%}<p class="sw-card__text">{{ block.settings.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Stillwag cards",
  "settings": [
    { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "trust", "label": "Trust row" }, { "value": "benefits", "label": "Benefits" }], "default": "trust" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "text", "label": "Text" }
  ],
  "blocks": [
    { "type": "card", "name": "Card", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [
        { "value": "none", "label": "None" }, { "value": "truck", "label": "Truck" }, { "value": "lock", "label": "Lock" }, { "value": "mail", "label": "Mail" }, { "value": "gift", "label": "Gift" },
        { "value": "heart", "label": "Heart" }, { "value": "leaf", "label": "Leaf" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "clock", "label": "Clock" }, { "value": "shield", "label": "Shield" }, { "value": "drop", "label": "Drop" }, { "value": "sun", "label": "Sun" }
      ], "default": "truck" },
      { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [{ "name": "Stillwag cards", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
